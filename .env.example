# VPN Config Parser — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.

# GitHub token — used for:
#  1. Fetching sources (5000 req/h with token vs 60 without)
#  2. Publishing the subscription file back to your repo
# Get it from: https://github.com/settings/tokens (classic token with repo scope)
GITHUB_TOKEN=

# GitHub owner/repo for publishing the subscription file
# In GitHub Actions these are auto-set from the workflow context.
# For local runs, set them manually.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# LLM API key for fallback parsing — OFF by default (llm.enabled: false in
# config/settings.yaml). The key must match llm.provider there, currently
# "dashscope" (model qwen-plus): https://dashscope.aliyun.com
# A key from another vendor 401s on every source, so switch llm.provider first
# if you use one.
LLM_API_KEY=

# Telegram bot notifications (optional)
# The bot sends a summary (config count + fun fact) after each pipeline run.
# Create a bot with @BotFather, get the token, and find your chat ID
# (e.g. via @userinfobot or by messaging the bot and checking getUpdates).
# Leave empty to skip Telegram notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SOCKS5 proxy for validation (optional override)
# If empty, settings.yaml can build a free SOCKS5 proxy pool from GitHub lists.
# Format: socks5://user:pass@host:port  or  socks5://host:port
VALIDATOR_PROXY=

# Path to the Xray-core binary used by the L3 liveness probe.
# settings.yaml ships xray_enabled: true with xray_required: true, so with no
# usable binary the liveness stage drops every config and the output is empty.
# A relative path is resolved from the project root (not the current directory);
# bare names fall back to PATH. Windows: bin/xray/xray.exe
XRAY_EXECUTABLE=bin/xray/xray

# Directory holding geoip.dat/geosite.dat for Xray (read by the binary itself).
# Only needed when the routing assets do not sit next to the binary.
XRAY_LOCATION_ASSET=
