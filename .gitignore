__pycache__/
*.pyc
.venv/
venv/
env/
bin/*
!bin/README.md
!bin/LICENSE
!bin/LICENSE-*
*.log
run*.err
*.pid
data/
.opencode/
# Local settings overrides: never tracked, they shadow config/settings.yaml
# on machines that use them and every stale copy in git history was a
# fail-open fork of the protections (proxy_pool.required etc.).
config/settings.local.yaml
# Every .env variant (.env.local, .env.bak from a rotation, …) holds live
# tokens; only the checked-in template is tracked.
.env
.env.*
!.env.example

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.dmypy.json
*.egg-info/
*.pyo
*.pyd
# hypothesis example database (regenerated per run; never track it)
.hypothesis/

# Coverage
.coverage
.coverage.*
*,cover
coverage/

# Stray scratch page at the repo root only — an unanchored `index.html` would
# also hide docs/index.html (GitHub Pages).
/index.html

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Project-specific artifacts
.agents/
.codex/
tsui-auto.user.js
facts_history.json
pipeline.err.log
# NOTE: no pipeline.log entry — the pipeline logs to stdout only (there is
# no pipeline.log file), so ignoring it would only hide a real file.

# Output (generated by pipeline; only .gitkeep files are tracked).
# Published via the Contents API, not via git — the ignore is intentional.
output/*
!output/.gitkeep
!output/locations/
output/locations/*
!output/locations/.gitkeep
# Runtime artifacts
status.json
summary.json
bl.txt
mix.txt
wl.txt
# Debug/scratch artifacts (local leftovers, never runtime outputs)
check_runs.json
cr2.json
runs.json
.claude/
.qoder/
