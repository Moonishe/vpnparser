.env
.env.*
!.env.example

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.dmypy.json
*.egg-info/
*.pyo
*.pyd

# Coverage
.coverage
.coverage.*
*,cover
coverage/

# Stray scratch page at the repo root only — an unanchored `index.html` would
# also hide docs/index.html (GitHub Pages).
/index.html

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Project-specific artifacts
.agents/
.codex/
.opencode/
tsui-auto.user.js
facts_history.json
pipeline.err.log
pipeline.log

# Output (generated by pipeline; only .gitkeep files are tracked)
output/*
!output/.gitkeep
!output/locations/
output/locations/*
!output/locations/.gitkeep
# Coverage artifacts
*.cover
.coverage*
